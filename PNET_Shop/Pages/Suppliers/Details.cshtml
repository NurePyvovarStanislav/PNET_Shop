@page "{id:int}"
@model PNET_Shop.Pages.Suppliers.DetailsModel
@{
    ViewData["Title"] = "Деталі постачальника";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Деталі постачальника</h1>
        <div>
            <a asp-page="./Edit" asp-route-id="@Model.Supplier.SupplierId" class="btn btn-warning">Редагувати</a>
            <a asp-page="./Index" class="btn btn-secondary">Назад</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Код</dt>
                <dd class="col-sm-9">@Model.Supplier.SupplierId</dd>

                <dt class="col-sm-3">Назва</dt>
                <dd class="col-sm-9"><strong>@Model.Supplier.Name</strong></dd>

                <dt class="col-sm-3">Телефон</dt>
                <dd class="col-sm-9">@(Model.Supplier.Phone ?? "—")</dd>

                <dt class="col-sm-3">Адреса</dt>
                <dd class="col-sm-9">@(Model.Supplier.Address ?? "—")</dd>
            </dl>
        </div>
    </div>
</div>
