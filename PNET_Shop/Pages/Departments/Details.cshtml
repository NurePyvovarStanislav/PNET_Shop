@page "{id:int}"
@model PNET_Shop.Pages.Departments.DetailsModel
@{
    ViewData["Title"] = "Деталі відділу";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Деталі відділу</h1>
        <div>
            <a asp-page="./Edit" asp-route-id="@Model.Department.DeptId" class="btn btn-warning">Редагувати</a>
            <a asp-page="./Index" class="btn btn-secondary">Назад</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Код</dt>
                <dd class="col-sm-9">@Model.Department.DeptId</dd>

                <dt class="col-sm-3">Назва</dt>
                <dd class="col-sm-9"><strong>@Model.Department.Name</strong></dd>

                <dt class="col-sm-3">Інформація</dt>
                <dd class="col-sm-9">@(Model.Department.Info ?? "—")</dd>
            </dl>
        </div>
    </div>
</div>
