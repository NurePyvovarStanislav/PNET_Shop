@page
@model PNET_Shop.Pages.Checks.IndexModel
@{
    ViewData["Title"] = "Чеки";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="mb-1">Чеки</h1>
            <p class="text-muted mb-0">Перегляд та керування чеками магазину</p>
        </div>

        <a asp-page="Create" class="btn btn-primary">
            + Додати чек
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-bordered mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Номер</th>
                        <th>Дата</th>
                        <th>Загальна сума</th>
                        <th>Касир</th>
                        <th class="text-center" style="width: 320px; min-width: 320px;">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Checks.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted p-4">
                                Дані відсутні
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Checks)
                        {
                            <tr>
                                <td><strong>@item.CheckNo</strong></td>
                                <td>@item.CheckDate.ToString("g")</td>
                                <td>@item.TotalSum</td>
                                <td>@(item.CashierName ?? "—")</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center align-items-center gap-2 flex-nowrap">
                                        <a asp-page="./Details" asp-route-id="@item.CheckNo" class="btn btn-sm btn-secondary">
                                            Деталі
                                        </a>

                                        <a asp-page="./Edit" asp-route-id="@item.CheckNo" class="btn btn-sm btn-warning">
                                            Редагувати
                                        </a>

                                        <a asp-page="./Delete" asp-route-id="@item.CheckNo" class="btn btn-sm btn-danger">
                                            Видалити
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
