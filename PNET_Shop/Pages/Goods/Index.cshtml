@page
@model PNET_Shop.Pages.Goods.IndexModel
@{
    ViewData["Title"] = "Товари";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="mb-1">Товари</h1>
            <p class="text-muted mb-0">Перегляд, пошук та керування товарами магазину</p>
        </div>

        <a asp-page="Create" class="btn btn-primary">
            + Додати товар
        </a>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form method="get">
                <div class="input-group">
                    <input type="text"
                           name="searchString"
                           value="@Model.SearchString"
                           class="form-control"
                           placeholder="Пошук за назвою, виробником, відділом або постачальником" />

                    <button type="submit" class="btn btn-outline-primary">
                        Пошук
                    </button>

                    <a asp-page="./Index" class="btn btn-outline-secondary">
                        Скинути
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-bordered mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Назва</th>
                        <th>Ціна</th>
                        <th>Кількість</th>
                        <th>Виробник</th>
                        <th>Відділ</th>
                        <th>Постачальник</th>
                        <th>Опис</th>
                        <th class="text-center" style="width: 320px; min-width: 320px;">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Goods.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted p-4">
                                Дані відсутні
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Goods)
                        {
                            <tr>
                                <td><strong>@item.Name</strong></td>
                                <td>@item.Price</td>
                                <td>@item.Quantity</td>
                                <td>@item.Producer</td>
                                <td>@item.Department?.Name</td>
                                <td>@item.Supplier?.Name</td>
                                <td>@item.Description</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center align-items-center gap-2 flex-nowrap">
                                        <a asp-page="./Details" asp-route-id="@item.GoodId" class="btn btn-sm btn-secondary">
                                            Деталі
                                        </a>

                                        <a asp-page="./Edit" asp-route-id="@item.GoodId" class="btn btn-sm btn-warning">
                                            Редагувати
                                        </a>

                                        <a asp-page="./Delete" asp-route-id="@item.GoodId" class="btn btn-sm btn-danger">
                                            Видалити
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>