@page "{id:int}"
@model PNET_Shop.Pages.Sales.DeleteModel
@{
    ViewData["Title"] = "Видалити продаж";
}

<div class="container mt-4">
    <h1 class="mb-3">Видалити продаж</h1>

    <div class="alert alert-warning">
        Ви впевнені, що хочете видалити цей продаж? Цю дію неможливо скасувати.
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">№ продажу</dt>
                <dd class="col-sm-9">@Model.Sale.SaleId</dd>

                <dt class="col-sm-3">Товар</dt>
                <dd class="col-sm-9"><strong>@Model.Sale.Good?.Name</strong></dd>

                <dt class="col-sm-3">Чек</dt>
                <dd class="col-sm-9">
                    @if (Model.Sale.Check != null)
                    {
                        <text>№@Model.Sale.Check.CheckNo — @Model.Sale.Check.CheckDate.ToString("dd.MM.yyyy")</text>
                    }
                </dd>

                <dt class="col-sm-3">Дата продажу</dt>
                <dd class="col-sm-9">@Model.Sale.DateSale.ToString("dd.MM.yyyy HH:mm")</dd>

                <dt class="col-sm-3">Кількість</dt>
                <dd class="col-sm-9">@Model.Sale.Quantity</dd>
            </dl>
        </div>
    </div>

    <form method="post">
        <input type="hidden" asp-for="Sale.SaleId" />
        <button type="submit" class="btn btn-danger">Видалити</button>
        <a asp-page="./Index" class="btn btn-secondary">Скасувати</a>
    </form>
</div>
